{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritvpn.io/schemas/desired-state/environment-v1alpha1.json",
  "title": "SpiritVPN Environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "spiritvpn.io/v1alpha1"},
    "kind": {"const": "Environment"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"enum": ["develop", "prod"]}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dns_zone", "management_network", "backend_endpoint", "secret_store"],
      "properties": {
        "dns_zone": {"type": "string", "format": "hostname", "minLength": 1, "maxLength": 253},
        "management_network": {"type": "string", "format": "ipv4-network"},
        "backend_endpoint": {"type": "string", "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$"},
        "secret_store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kv", "pki"],
          "properties": {
            "kv": {"type": "string", "pattern": "^kv/(develop|prod)$"},
            "pki": {"type": "string", "pattern": "^pki/(develop|prod)$"}
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend_release", "postgres", "authorization"],
          "properties": {
            "backend_release": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_git_sha", "backend_image", "migration_image"],
              "properties": {
                "source_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "backend_image": {"$ref": "#/$defs/immutableImage"},
                "migration_image": {"$ref": "#/$defs/immutableImage"}
              }
            },
            "postgres": {
              "type": "object",
              "additionalProperties": false,
              "required": ["image", "exporter_image", "major_version", "database", "owner_user", "runtime_user", "backup_required"],
              "properties": {
                "image": {"$ref": "#/$defs/immutableImage"},
                "exporter_image": {"$ref": "#/$defs/immutableImage"},
                "major_version": {"type": "integer", "minimum": 14, "maximum": 20},
                "database": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
                "owner_user": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
                "runtime_user": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
                "backup_required": {"type": "boolean"},
                "external_backup_command_argv": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {"type": "string", "minLength": 1, "maxLength": 4096}
                }
              }
            },
            "authorization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["customer_access_writers", "customer_access_readers"],
              "properties": {
                "customer_access_writers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
                "customer_access_readers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}}
              }
            },
            "public_endpoint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hostname", "address"],
              "properties": {
                "hostname": {"type": "string", "minLength": 1, "maxLength": 253},
                "address": {"type": "string", "minLength": 1, "maxLength": 45}
              }
            },
            "bot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["release", "postgres", "settings", "ingress"],
              "properties": {
                "release": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source_git_sha", "image"],
                  "properties": {
                    "source_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                    "image": {"$ref": "#/$defs/immutableImage"}
                  }
                },
                "postgres": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["database", "owner_user", "runtime_user"],
                  "properties": {
                    "database": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
                    "owner_user": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
                    "runtime_user": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"}
                  }
                },
                "settings": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["client_identity", "friends_plan_fleet"],
                  "properties": {
                    "client_identity": {"type": "string", "minLength": 1, "maxLength": 253},
                    "friends_plan_fleet": {"type": "string", "minLength": 1, "maxLength": 63},
                    "friends_plan_quota_bytes": {"type": "integer", "minimum": 1},
                    "friends_plan_duration_days": {"type": "integer", "minimum": 1, "maximum": 3650}
                  }
                },
                "ingress": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["image", "hostname"],
                  "properties": {
                    "image": {"$ref": "#/$defs/immutableImage"},
                    "hostname": {"type": "string", "format": "hostname", "minLength": 1, "maxLength": 253}
                  }
                }
              }
            }
          }
        },
        "common_overrides": {"type": "object"}
      }
    }
  },
  "$defs": {
    "immutableImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
