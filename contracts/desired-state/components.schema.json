{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritvpn.io/schemas/desired-state/components.schema.json",
  "title": "Common component versions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {
          "oneOf": [
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
