{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritvpn.io/schemas/desired-state/platform-v1alpha1.json",
  "title": "SpiritVPN Platform",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "spiritvpn.io/v1alpha1"},
    "kind": {"const": "Platform"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^(develop|staging|prod)-platform$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "public_address", "provider", "ssh", "vault", "github_actions"],
      "properties": {
        "environment": {"enum": ["develop", "staging", "prod"]},
        "public_address": {"type": "string", "format": "ipv4"},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "resource_id"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 63},
            "resource_id": {"type": "string", "minLength": 1, "maxLength": 255}
          }
        },
        "ssh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bootstrap_user", "runtime_user", "host_key_fingerprints"],
          "properties": {
            "bootstrap_user": {"const": "root"},
            "runtime_user": {"const": "deploy"},
            "host_key_fingerprints": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"}
            }
          }
        },
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api_port", "cluster_port", "tls_server_name", "tls_certificate_ref", "tls_private_key_ref"],
          "properties": {
            "api_port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "cluster_port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "tls_server_name": {"type": "string", "format": "hostname", "minLength": 1, "maxLength": 253},
            "tls_certificate_ref": {"type": "string", "pattern": "^secret://bootstrap/(develop|staging|prod)/platform/vault#tls_certificate$"},
            "tls_private_key_ref": {"type": "string", "pattern": "^secret://bootstrap/(develop|staging|prod)/platform/vault#tls_private_key$"}
          }
        },
        "github_actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "environment", "oidc_audience"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "environment": {"enum": ["develop", "staging", "prod"]},
            "oidc_audience": {"type": "string", "format": "uri", "pattern": "^https://github[.]com/"}
          }
        }
      }
    }
  }
}
