# Only the reviewed management bootstrap inventory may be tracked. Ignore any
# local inventory experiments so they cannot become a second source of truth.
inventories/*/
!inventories/bootstrap/
inventories/bootstrap/*
!inventories/bootstrap/.gitkeep
!inventories/bootstrap/platform.sops.yml
_render/
*.decrypted
*.plain.yml
vault-unseal-keys*
INIT-SECRETS*
*.key
*.pem
!roles/**/templates/*.pem.j2
.vault_pass
*.retry
__pycache__/
.env
.local.json
.local-secrets/
client-*.json
smoke-client.json
s.sh
generated/
build/
.fleetctl-state/
# Local Python/Ansible environments are machine-specific build artifacts.
ansible-env/
.venv/
deploy-e2e.log
support-bundle/
# editor / patch / backup cruft — never commit (may contain secrets)
*.orig
*.rej
*.bak
*.bak.*
# Recovery material belongs in approved external storage, never this repository.
recovery/*
