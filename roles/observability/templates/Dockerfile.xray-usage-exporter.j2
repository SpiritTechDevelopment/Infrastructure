# Managed by Ansible (roles/observability). Multi-stage build: copy the pinned,
# statically-linked Xray client binary into a minimal Python runtime so the
# exporter can call StatsService without a docker.sock mount.
FROM {{ xray_image }} AS xray

FROM {{ usage_exporter_base_image }}
COPY --from=xray /usr/local/bin/xray /usr/local/bin/xray
COPY xray-usage-exporter.py /usr/local/bin/xray-usage-exporter.py
USER 65534:65534
EXPOSE {{ usage_exporter_port }}
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=10s \
  CMD ["python3", "-c", "import urllib.request,os; urllib.request.urlopen('http://127.0.0.1:'+os.environ['USAGE_EXPORTER_PORT']+'/metrics').read()"]
ENTRYPOINT ["python3", "/usr/local/bin/xray-usage-exporter.py"]
