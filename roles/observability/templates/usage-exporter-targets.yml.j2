{# Entry-node Xray API endpoints for the per-user usage exporter. Per-user stats
   only exist on entry nodes (the vless-in inbound where customer UUIDs
   terminate); exit nodes carry only the single svc-entry-<country> client. #}
{% set entries = [] %}
{% for h in (groups['entry'] | default([])) %}
{% if hostvars[h].node_enabled | default(true) | bool %}
{% set _ = entries.append({
     'node': h,
     'server': (hostvars[h].xray_api_overlay_host | default(hostvars[h].xray_api_public_host | default(hostvars[h].ansible_host | default(h))))
               ~ ':' ~ (hostvars[h].xray_api_port | default(10085))
   }) %}
{% endif %}
{% endfor %}
{{ entries | to_nice_json }}
