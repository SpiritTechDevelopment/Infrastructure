name: observability
services:
  loki:
    image: {{ loki_image }}
    restart: unless-stopped
    command: ["-config.file=/etc/loki/config.yml"]
    ports: ["{{ platform_bind_address }}:{{ loki_port }}:{{ loki_port }}"]
    volumes:
      - ./loki/config.yml:/etc/loki/config.yml:ro
      - ./loki/overrides.yml:/etc/loki/overrides.yml:ro
      - loki-data:/loki

  prometheus:
    image: {{ prometheus_image }}
    restart: unless-stopped
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=30d"
      - "--web.enable-remote-write-receiver"
    ports: ["{{ platform_bind_address }}:{{ prometheus_port }}:{{ prometheus_port }}"]
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prometheus-data:/prometheus

  alertmanager:
    image: {{ alertmanager_image }}
    restart: unless-stopped
    ports: ["{{ platform_bind_address }}:{{ alertmanager_port }}:{{ alertmanager_port }}"]
    volumes:
      - ./alertmanager/config.yml:/etc/alertmanager/alertmanager.yml:ro

  blackbox:
    image: {{ blackbox_image }}
    restart: unless-stopped
    command: ["--config.file=/etc/blackbox_exporter/config.yml"]
    volumes:
      - ./blackbox/config.yml:/etc/blackbox_exporter/config.yml:ro

  grafana:
    image: {{ grafana_image }}
    restart: unless-stopped
    ports: ["{{ platform_bind_address }}:{{ grafana_port }}:{{ grafana_port }}"]
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro

  node-exporter:
    image: {{ node_exporter_image }}
    restart: unless-stopped
    pid: host
    command:
      - "--path.rootfs=/host"
      # Reads host-local textfile metrics (e.g. the vault seal-state metric).
      - "--collector.textfile.directory=/host{{ node_exporter_textfile_dir }}"
    volumes:
      - /:/host:ro,rslave

  alloy:
    image: {{ alloy_image }}
    # Docker discovery needs read access to /var/run/docker.sock. Run as root in
    # this no-hardening runtime so log collection cannot silently fail on socket mode.
    user: "0:0"
    restart: unless-stopped
    volumes:
      - ./alloy/config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - platform-alloy-data:/var/lib/alloy
    command: ["run", "/etc/alloy/config.alloy", "--storage.path=/var/lib/alloy"]
    depends_on:
      - loki

  # Per-user usage exporter: reads Xray StatsService from each entry node and
  # re-exposes per-user byte counters for Prometheus. No host port publish —
  # scraped over the compose network. No docker.sock: the Xray client binary is
  # baked into the image via multi-stage build.
  xray-usage-exporter:
    build: ./xray-usage-exporter
    image: spirit-xray-usage-exporter:local
    restart: unless-stopped
    environment:
      USAGE_EXPORTER_PORT: "{{ usage_exporter_port }}"
      USAGE_EXPORTER_INTERVAL: "{{ usage_exporter_interval }}"
      USAGE_EXPORTER_QUERY_TIMEOUT: "{{ usage_exporter_query_timeout }}"
      USAGE_EXPORTER_TOP_N: "{{ usage_exporter_top_n }}"
      USAGE_EXPORTER_TARGETS: "/etc/xray-usage-exporter/targets.json"
    volumes:
      - ./xray-usage-exporter/targets.json:/etc/xray-usage-exporter/targets.json:ro

volumes:
  loki-data: {}
  prometheus-data: {}
  grafana-data: {}
  platform-alloy-data: {}
