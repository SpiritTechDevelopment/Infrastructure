groups:
  - name: fleet
    rules:
      - alert: PublicServiceDown
        expr: probe_success{job="blackbox-public"} == 0
        for: 5m
        labels: {severity: critical}
        annotations:
          summary: "{% raw %}{{ $labels.node }} {{ $labels.service }} is unreachable at {{ $labels.instance }}{% endraw %}"
{% for host in (groups['entry'] | default([])) + (groups['exit'] | default([])) %}
{% if hostvars[host].node_enabled | default(true) | bool %}
      - alert: NodeTelemetryMissing
        expr: absent_over_time(node_uname_info{instance="{{ host }}"}[10m])
        for: 2m
        labels:
          severity: warning
          node: "{{ host }}"
        annotations:
          summary: "Node telemetry is missing for {{ host }}"
{% endif %}
{% endfor %}
      - alert: PlatformTelemetryMissing
        expr: absent_over_time(node_uname_info{instance="{{ inventory_hostname }}"}[10m])
        for: 2m
        labels:
          severity: warning
          node: "{{ inventory_hostname }}"
        annotations:
          summary: "Platform telemetry is missing for {{ inventory_hostname }}"
  - name: vault
    rules:
      # Vault has no auto-unseal and re-seals on every restart; while sealed the
      # SSH CA cannot sign. Source metric: the vault-seal-metric timer's textfile
      # (roles/vault). This alert belongs to the retained legacy platform stack.
      - alert: VaultSealed
        expr: vault_sealed == 1
        for: 2m
        labels:
          severity: critical
          node: "{{ inventory_hostname }}"
        annotations:
          summary: "Vault is SEALED on {{ inventory_hostname }} — SSH CA cannot sign; unseal per OPERATIONS §9"
      - alert: VaultUnreachable
        expr: vault_up == 0
        for: 5m
        labels:
          severity: warning
          node: "{{ inventory_hostname }}"
        annotations:
          summary: "Vault health check failing on {{ inventory_hostname }} (container down or unreachable)"
      - alert: VaultSealMetricMissing
        expr: absent_over_time(vault_up[10m])
        for: 2m
        labels:
          severity: warning
          node: "{{ inventory_hostname }}"
        annotations:
          summary: "Vault seal-state metric absent on {{ inventory_hostname }} — vault-seal-metric.timer may be down"
