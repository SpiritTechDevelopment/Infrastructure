{
  "uid": "vpn-user-usage",
  "title": "VPN Per-User Usage",
  "tags": [
    "vpn",
    "usage"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "topn",
        "label": "Top N",
        "type": "custom",
        "query": "10,20,50,100",
        "current": {
          "text": "20",
          "value": "20"
        },
        "options": [
          {"text": "10", "value": "10", "selected": false},
          {"text": "20", "value": "20", "selected": true},
          {"text": "50", "value": "50", "selected": false},
          {"text": "100", "value": "100", "selected": false}
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active users tracked",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (email) (xray_user_traffic_bytes_total))",
          "instant": true,
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Entry nodes reporting usage",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(xray_usage_exporter_node_up)",
          "instant": true,
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total tracked traffic",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {"unit": "decbytes"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(xray_user_traffic_bytes_total)",
          "instant": true,
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top users by total traffic",
      "gridPos": {"h": 12, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "decbytes"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "email"},
            "properties": [{"id": "unit", "value": "string"}]
          }
        ]
      },
      "options": {
        "sortBy": [{"displayName": "Value", "desc": true}]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk($topn, sum by (email) (xray_user_traffic_bytes_total))",
          "instant": true,
          "format": "table",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true},
            "renameByName": {"Value": "Total bytes"}
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Top users by throughput (bits/s)",
      "gridPos": {"h": 12, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk($topn, sum by (email) (rate(xray_user_traffic_bytes_total[5m])) * 8)",
          "legendFormat": "{{email}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Aggregate customer throughput by direction (bits/s)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(xray_user_traffic_bytes_total[5m])) * 8",
          "legendFormat": "{{direction}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    }
  ]
}
