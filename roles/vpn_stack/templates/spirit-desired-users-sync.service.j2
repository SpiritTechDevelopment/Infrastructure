[Unit]
Description=Fetch authoritative SpiritVPN users for Xray reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ xray_reconcile_libdir }}/fetch-desired-users.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ xray_reconcile_snapshot | dirname }}
