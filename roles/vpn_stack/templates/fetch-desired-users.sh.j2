#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

url="{{ xray_desired_users_url }}"
token_file="{{ xray_desired_users_token_file }}"
snapshot="{{ xray_reconcile_snapshot }}"
snapshot_dir="$(dirname "$snapshot")"
tmp="$(mktemp "$snapshot_dir/.desired-users.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

token="$(cat "$token_file")"
curl --fail --silent --show-error \
  --connect-timeout 5 \
  --max-time 15 \
  --header "Authorization: Bearer $token" \
  "$url" >"$tmp"

python3 - "$tmp" <<'PY'
import json
import re
import sys
import uuid

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    payload = json.load(handle)

users = payload.get("users")
if not isinstance(users, list):
    raise SystemExit("snapshot response must contain a users list")

email_pattern = re.compile(r"^[A-Za-z0-9._@:+-]{1,128}$")
seen = set()
for index, user in enumerate(users):
    if not isinstance(user, dict):
        raise SystemExit(f"users[{index}] must be an object")
    if set(user) != {"uuid", "email", "flow"}:
        raise SystemExit(f"users[{index}] contains an unexpected schema")
    uuid.UUID(user["uuid"])
    if not email_pattern.fullmatch(user["email"]):
        raise SystemExit(f"users[{index}] contains an invalid email identifier")
    if user["flow"] != "xtls-rprx-vision":
        raise SystemExit(f"users[{index}] contains an unsupported flow")
    if user["email"] in seen:
        raise SystemExit(f"duplicate desired user: {user['email']}")
    seen.add(user["email"])
PY

chmod 0600 "$tmp"
mv -f "$tmp" "$snapshot"
trap - EXIT
