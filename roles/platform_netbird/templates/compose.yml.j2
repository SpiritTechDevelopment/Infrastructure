{{ ansible_managed | comment }}
name: spiritvpn-netbird

# Предел на логи контейнера. См. тот же блок в roles/platform_observability: у
# json-file нет предела по умолчанию, а daemon.json потребовал бы перезапуска
# Docker, то есть простоя всего, что крутится на хабе.
x-logging: &logging
  driver: json-file
  options:
    max-size: "{{ platform_netbird_log_max_size }}"
    max-file: "{{ platform_netbird_log_max_files }}"

services:
  netbird:
    image: {{ platform_netbird_image }}
    restart: unless-stopped
    logging: *logging
    stop_grace_period: 30s
    # Сеть хоста, как у Prometheus рядом, и по более жёсткой причине: STUN
    # обязан видеть настоящий адрес источника. За NAT Docker он увидел бы адрес
    # моста, и определение внешнего адреса peer'а — то единственное, ради чего
    # STUN существует — сломалось бы молча.
    #
    # HTTP при этом слушается на петле: наружу сервер выводит прокси.
    network_mode: host
    command:
      - --config
      - /etc/netbird/config.yaml
    volumes:
      - {{ platform_netbird_dir }}/config.yaml:/etc/netbird/config.yaml:ro
      - {{ platform_netbird_tls_certificate_file }}:/etc/netbird/tls/fullchain.pem:ro
      - {{ platform_netbird_tls_private_key_file }}:/etc/netbird/tls/privkey.pem:ro
      - {{ platform_netbird_data_dir }}:/var/lib/netbird
    # Healthcheck здесь намеренно отсутствует. Образ собран на Ubuntu, куда
    # добавлены только ca-certificates: ни wget, ни curl внутри нет, и проверка
    # по HTTP изнутри контейнера не выполнится никогда. Такая проверка хуже
    # отсутствующей — она вечно докладывает «unhealthy», и `compose up --wait`
    # сдаётся на исправно работающем сервере.
    #
    # Готовность проверяет задача роли сразу после этой: она ходит на
    # healthcheckAddress с самого хоста, ничего не требуя от содержимого образа.

  dashboard:
    image: {{ platform_netbird_dashboard_image }}
    restart: unless-stopped
    logging: *logging
    # Не сеть хоста: образ слушает :80 и на хосте занял бы этот порт целиком.
    # Публикация на петлю оставляет его доступным одному лишь прокси и не
    # требует от образа уметь менять адрес привязки.
    ports:
      - "127.0.0.1:{{ platform_netbird_dashboard_port }}:80"
    environment:
      NETBIRD_MGMT_API_ENDPOINT: "https://{{ platform_netbird_hostname }}"
      NETBIRD_MGMT_GRPC_API_ENDPOINT: "https://{{ platform_netbird_hostname }}"
      AUTH_AUTHORITY: "https://{{ platform_netbird_hostname }}/oauth2"
      AUTH_CLIENT_ID: "netbird-dashboard"
      AUTH_AUDIENCE: "netbird-dashboard"
      # Без `api`. Этот scope нужен внешним провайдерам, где им выбирается
      # audience; встроенный Dex его не объявляет — в discovery перечислены
      # только openid, email, groups, profile и offline_access, — и на
      # неизвестном scope роняет весь запрос авторизации:
      #
      #   ERRO [err: Unrecognized scope(s) ["api"]] failed to parse
      #   authorization request
      #
      # Дашборд получает редирект с `error=invalid_scope` и показывает
      # «Unauthenticated», что уводит в сторону: отказ выглядит как проблема
      # учётных данных, хотя до проверки пароля дело не доходит.
      #
      # Audience при этом не теряется: сервер приравнивает его к client_id
      # (`combined/cmd/config.go`, AuthClientID = AuthAudience), поэтому
      # netbird-dashboard в токене оказывается и без отдельного scope.
      AUTH_SUPPORTED_SCOPES: "openid profile email offline_access"
      AUTH_REDIRECT_URI: "/nb-auth"
      AUTH_SILENT_REDIRECT_URI: "/nb-silent-auth"
      USE_AUTH0: "false"

  proxy:
    image: {{ platform_netbird_proxy_image }}
    restart: unless-stopped
    logging: *logging
    # Сеть хоста: прокси обязан доставать и сервер на петле, и дашборд на
    # опубликованном порту петли, и слушать 443 на публичном интерфейсе.
    network_mode: host
    volumes:
      - {{ platform_netbird_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ platform_netbird_tls_certificate_file }}:/etc/netbird/tls/fullchain.pem:ro
      - {{ platform_netbird_tls_private_key_file }}:/etc/netbird/tls/privkey.pem:ro
    depends_on:
      - netbird
      - dashboard
{% if platform_netbird_client_enabled %}

  # Клиент оверлея. Отдельный образ, а не тот же, что у сервера: сервер живёт в
  # netbirdio/netbird-server, клиент — в netbirdio/netbird.
  #
  # Он делает хаб участником собственной сети. Без него сервер раздаёт оверлей,
  # в котором сам не состоит, и подключившемуся оператору не с кем говорить.
  client:
    image: {{ platform_netbird_client_image }}
    restart: unless-stopped
    logging: *logging
    # Сеть хоста обязательна: интерфейс оверлея должен появиться в сетевом
    # пространстве самого хаба, иначе до Grafana и Vault он не доводит.
    network_mode: host
    # Набор из client/Dockerfile v0.76.3, где он указан в примере запуска.
    # NET_ADMIN — интерфейс и маршруты, NET_RAW и BPF — обработка пакетов.
    cap_add:
      - NET_ADMIN
      - NET_RAW
      - BPF
    # Запасной путь на случай ядра без модуля WireGuard: тогда клиент поднимает
    # интерфейс в userspace через TUN.
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      NB_MANAGEMENT_URL: "https://{{ platform_netbird_hostname }}"
      NB_HOSTNAME: "{{ platform_netbird_client_peer_hostname }}"
      NB_SETUP_KEY_FILE: /etc/netbird-setup-key
      NB_LOG_LEVEL: "{{ platform_netbird_log_level }}"
      # Образ по умолчанию пишет и в консоль, и в файл внутри контейнера.
      # Файл никуда не смонтирован и рос бы в слое контейнера без предела,
      # мимо ограничения json-file выше.
      NB_LOG_FILE: console
    volumes:
      - {{ platform_netbird_client_data_dir }}:/var/lib/netbird
      # Вне каталога состояния намеренно: вложенный bind поверх тома работает,
      # но зависит от порядка применения монтирований.
      - {{ platform_netbird_client_setup_key_file }}:/etc/netbird-setup-key:ro
    depends_on:
      - proxy
{% endif %}
