{{ ansible_managed | comment }}
# GENERATED — DO NOT EDIT. Источник: roles/platform_netbird.
#
# Сверено с исходником v0.76.3, а не с примером конфигурации: пример показывает
# блок `tls` так, будто сервер терминирует TLS сам, и это ввело в заблуждение.
# На деле `combined/cmd/root.go` загружает сертификат и результат отбрасывает,
# оставляя лишь признак для relay. TLS терминирует nginx перед сервером — как и
# говорила обзорная документация.

server:
  # Петля: наружу сервер выводит nginx, он же терминирует TLS. Один порт на
  # Management, Signal и Relay — так устроен combined-сервер.
  listenAddress: "{{ platform_netbird_http_bind_address }}:{{ platform_netbird_http_port }}"
  exposedAddress: "https://{{ platform_netbird_hostname }}:{{ platform_netbird_listen_port }}"

  stunPorts:
    - {{ platform_netbird_stun_port }}

  # Не 9090 и не все интерфейсы: 9090 занят Prometheus этого же хаба, а метрики
  # контура описывают состав флота и наружу не показываются.
  metricsPort: {{ platform_netbird_metrics_port }}
  healthcheckAddress: "{{ platform_netbird_healthcheck_bind_address }}:{{ platform_netbird_healthcheck_port }}"

  logLevel: "{{ platform_netbird_log_level }}"
  logFile: "console"

  # Этот блок TLS не включает — основной слушатель остаётся HTTP, его
  # шифрует nginx. Сертификат здесь нужен для другого: `handleTLSConfig`
  # загружает его и возвращает признак, по которому relay объявляет себя как
  # `rels://`, а не `rel://`. Убрать блок значит заставить relay рекламировать
  # незашифрованный адрес при живом TLS на прокси.
  tls:
    certFile: "/etc/netbird/tls/fullchain.pem"
    keyFile: "/etc/netbird/tls/privkey.pem"
    letsencrypt:
      enabled: false

  authSecret: "{{ platform_netbird_auth_secret }}"
  dataDir: "/var/lib/netbird/"

  disableAnonymousMetrics: true

  auth:
    issuer: "https://{{ platform_netbird_hostname }}/oauth2"
    # Встроенный Dex. Внешний OIDC — отдельная работа вторым заходом; см.
    # раздел 3.8 документа о переходе. Здесь важно, что задача идентичности
    # оператора этим не решается, а откладывается.
    localAuthDisabled: false
    signKeyRefreshEnabled: true
    dashboardRedirectURIs:
      - "https://{{ platform_netbird_hostname }}/nb-auth"
      - "https://{{ platform_netbird_hostname }}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"
    owner:
      email: "{{ platform_netbird_owner_email }}"
      # Здесь bcrypt-хеш, а не пароль. Имя ключа вводит в заблуждение: сервер
      # кладёт это значение в поле `Hash` (`combined/cmd/config.go`), которое в
      # `management/server/idp/embedded.go` объявлено как «bcrypt hash of the
      # user's password (required)». Открытый текст даёт отказ входа с
      # `hashedSecret too short to be a bcrypted password`, а дашборд показывает
      # его как проблему учётных данных — то есть уводит в сторону.
      password: "{{ platform_netbird_owner_password_hash }}"

  store:
    # sqlite, а не Postgres контура control. NetBird обязан подниматься и тогда,
    # когда выкатка окружения сломана; зависимость управляющего оверлея от базы
    # окружения сделала бы отказ окружения отказом доступа к флоту.
    engine: "sqlite"
    encryptionKey: "{{ platform_netbird_store_encryption_key }}"

  reverseProxy:
    # Прокси стоит на этой же машине, поэтому доверенный источник — петля.
    # Без этого сервер видел бы адрес nginx вместо адреса клиента.
    trustedHTTPProxies:
      - "127.0.0.1/32"
    trustedPeers:
      - "{{ platform_netbird_network }}"
