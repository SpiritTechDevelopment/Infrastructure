#!/usr/bin/env bash
# Managed by Ansible (roles/vault). Writes Vault seal state as a node-exporter
# textfile metric so a silent re-seal pages via the "VaultSealed" alert instead
# of surfacing later as an SSH-CA signing failure. See OPERATIONS.md §9.
#
# Vault is loopback-only ({{ vault_api_addr }}); the blackbox exporter runs in a
# container and cannot reach host loopback, so we probe here on the host and hand
# the result to node-exporter via its textfile collector.
set -uo pipefail

OUT_DIR="{{ node_exporter_textfile_dir }}"
OUT_FILE="${OUT_DIR}/vault.prom"
VAULT_ADDR="{{ vault_api_addr }}"

# /v1/sys/health status codes: 200 active, 429 standby, 503 sealed, 501 uninit.
# standbyok=true so a standby node reports 200; explicit sealed/uninit codes.
code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
  "${VAULT_ADDR}/v1/sys/health?standbyok=true&sealedcode=503&uninitcode=501" \
  2>/dev/null || echo 000)"

case "$code" in
  200|429) up=1; sealed=0 ;;   # unsealed (active or standby)
  503)     up=1; sealed=1 ;;   # sealed
  501)     up=1; sealed=0 ;;   # reachable but uninitialised (out of scope here)
  *)       up=0; sealed=0 ;;   # unreachable / container down
esac

tmp="$(mktemp "${OUT_DIR}/vault.prom.XXXXXX")" || exit 0
cat > "$tmp" <<EOF
# HELP vault_up Vault health endpoint reachable (1) or not (0).
# TYPE vault_up gauge
vault_up ${up}
# HELP vault_sealed Vault is sealed (1) or unsealed (0). Meaningful only when vault_up=1.
# TYPE vault_sealed gauge
vault_sealed ${sealed}
# HELP vault_health_status_code Raw HTTP status returned by /v1/sys/health (0 = unreachable).
# TYPE vault_health_status_code gauge
vault_health_status_code ${code}
EOF
chmod 0644 "$tmp"
mv -f "$tmp" "$OUT_FILE"
