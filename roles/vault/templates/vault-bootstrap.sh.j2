#!/usr/bin/env bash
set -euo pipefail
if [[ -z "${VAULT_TOKEN:-}" ]]; then
  read -rsp "Temporary Vault root token: " VAULT_TOKEN
  echo
fi
export VAULT_ADDR="{{ vault_api_addr }}"
v(){ docker compose -f {{ vault_dir }}/compose.yml exec -T -e VAULT_ADDR="$VAULT_ADDR"{% if vault_tls_enabled | bool %} -e VAULT_CACERT=/vault/tls/vault.crt{% endif %} -e VAULT_TOKEN="$VAULT_TOKEN" vault vault "$@"; }
v audit enable file file_path=/vault/audit/audit.log || true
v secrets enable -path=secret kv-v2 || true
v auth enable approle || true
v policy write backend /vault/config/policy-backend.hcl
v write auth/approle/role/backend token_policies=backend token_ttl=15m token_max_ttl=1h secret_id_ttl=10m secret_id_num_uses=1
unset VAULT_TOKEN
printf 'Vault bootstrap complete. Xray user management uses the Xray gRPC API, not Vault.\n'
