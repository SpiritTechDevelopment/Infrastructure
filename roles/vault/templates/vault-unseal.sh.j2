#!/usr/bin/env bash
set -euo pipefail
export VAULT_ADDR="{{ vault_api_addr }}"
read -rsp "Unseal key share: " KEY
echo
printf '%s' "$KEY" | docker compose -f {{ vault_dir }}/compose.yml exec -T \
  -e VAULT_ADDR="$VAULT_ADDR"{% if vault_tls_enabled | bool %} -e VAULT_CACERT=/vault/tls/vault.crt{% endif %} vault \
  sh -c 'read -r key; vault operator unseal "$key"'
unset KEY
