#!/bin/sh
set -eu
umask 077

marker='{{ pki_agent_directory }}/renewal-required'
certificate='{{ pki_agent_certificate_path }}'
if [ -s "$certificate" ] && openssl x509 -in "$certificate" -noout -checkend '{{ pki_agent_minimum_validity_seconds }}' >/dev/null 2>&1; then
  rm -f "$marker"
  exit 0
fi

cat > "$marker" <<EOF
status=OPERATOR_ACTION_REQUIRED
action=sign-csr
identity={{ pki_agent_identity }}
csr={{ pki_agent_csr_path }}
EOF
chmod 0600 "$marker"
