# Выпуск материала новой ноды. Отдельная политика, а не расширение
# fleet-deployer: тот читает секреты всего окружения и обязан оставаться
# read-only. Право записи, добавленное туда, дало бы исполнителю возможность
# переписать любой секрет контура — включая пароли PostgreSQL и окружение бота.
#
# Здесь запись есть, но только под `nodes/`, и только `create`. `update` не
# выдаётся намеренно: перегенерация ключа живой ноды убивает её вместе со всеми
# входами, которые на неё смотрят, и делает это молча. Отказ на уровне политики
# сильнее проверки в скрипте — он переживёт правку скрипта.
#
# `delete` и `destroy` тоже отсутствуют: снятие ноды с обслуживания идёт через
# топологию и ревью, а не через стирание секрета из-под работающей машины.
path "kv/data/{{ policy_environment }}/nodes/*" {
  capabilities = ["create", "read"]
}

# Метаданные нужны для проверки «путь уже существует»: `kv get` по
# несуществующему пути в KV v2 отвечает 404, и отличить «нет такого» от
# «нет доступа» без чтения метаданных нельзя.
path "kv/metadata/{{ policy_environment }}/nodes/*" {
  capabilities = ["read", "list"]
}
