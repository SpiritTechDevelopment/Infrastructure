name: spiritvpn-platform-vault

# У этого сервиса предела на логи намеренно нет — в отличие от остальных
# compose-контуров.
#
# Любое изменение этого файла приводит к `Recreated` на ближайшем
# `docker compose up -d`, то есть к перезапуску процесса Vault. Стансы `seal`
# в vault.hcl нет: хранилище раскрывается shamir-долями вручную, через
# spiritvpn-vault-operator. Значит перезапуск оставляет Vault запечатанным, а
# запечатанный Vault останавливает и fleet-deploy, и control-deploy — им негде
# взять секреты.
#
# Цена другой чаши: лог Vault занимал 168 КиБ за пять суток работы (замер на
# хабе 2026-08-19, все контейнеры вместе — 688 КиБ). Церемония раскрытия ради
# потолка над таким ростом — обмен не в ту сторону. Предел здесь появится
# тогда, когда Vault будет перезапускаться по собственной причине.
services:
  vault:
    image: "{{ platform_vault_image }}"
    user: "100:1000"
    restart: unless-stopped
    command: ["vault", "server", "-config=/vault/config/vault.hcl"]
    environment:
      SKIP_SETCAP: "true"
    cap_drop: ["ALL"]
    security_opt: ["no-new-privileges:true"]
    ports:
      # Петля остаётся первой и неизменной: исполнитель и операторские скрипты
      # ходят сюда локально, а SAN сертификата уже содержит 127.0.0.1.
      - "127.0.0.1:{{ platform_vault_api_port }}:{{ platform_vault_api_port }}"
      - "127.0.0.1:{{ platform_vault_cluster_port }}:{{ platform_vault_cluster_port }}"
{% if platform_vault_overlay_address | length > 0 %}
      # Оверлейный адрес — ради UI. Порт открыт firewall'ом только операторским
      # адресам: узел флота до него не дотянется. Кластерный порт наружу не
      # публикуется — узел Raft здесь один.
      - "{{ platform_vault_overlay_address }}:{{ platform_vault_api_port }}:{{ platform_vault_api_port }}"
{% endif %}
    volumes:
      - ./config:/vault/config:ro
      - ./tls:/vault/tls:ro
      - ./data:/vault/data
      - ./audit:/vault/audit
      - ./snapshots:/vault/snapshots
