logging {
  level = "info"
}

discovery.docker "vpn" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "vpn" {
  targets = discovery.docker.vpn.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "vpn"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
    regex         = "/(.*)"
    replacement   = "$1"
  }

  rule {
    target_label = "node"
    replacement  = "{{ inventory_hostname }}"
  }

  rule {
    target_label = "role"
    replacement  = "{{ node_role }}"
  }

  rule {
    target_label = "country"
    replacement  = "{{ country | default('unknown') }}"
  }
}

loki.source.docker "vpn" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.vpn.output
  forward_to = [loki.write.ops.receiver]
}

loki.write "ops" {
  endpoint {
    url       = "{{ loki_ops_endpoint }}"
    tenant_id = "ops"
{% if telemetry_username | length > 0 %}

    basic_auth {
      username = "{{ telemetry_username }}"
      password = "{{ telemetry_password }}"
    }
{% endif %}
  }
}

prometheus.scrape "node" {
  targets = [{
    "__address__" = "{{ node_exporter_bind_address }}:{{ node_exporter_port }}",
    "instance"    = "{{ inventory_hostname }}",
    "job"         = "node",
    "role"        = "{{ node_role }}",
    "country"     = "{{ country | default('unknown') }}",
  }]

  forward_to = [prometheus.remote_write.platform.receiver]
}

prometheus.remote_write "platform" {
  endpoint {
    url = "{{ prometheus_remote_write }}"
{% if telemetry_username | length > 0 %}

    basic_auth {
      username = "{{ telemetry_username }}"
      password = "{{ telemetry_password }}"
    }
{% endif %}
  }
}
