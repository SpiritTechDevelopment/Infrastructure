#!/usr/bin/env bash
# Managed by Ansible (roles/common). Host-level egress shaping (spec §17.1).
set -euo pipefail
IFACE="{{ tc_egress_iface if tc_egress_iface else '$(ip route show default | awk "{print \\$5; exit}")' }}"
RATE="{{ tc_egress_rate }}"
QDISC="{{ tc_qdisc }}"
tc qdisc del dev "$IFACE" root 2>/dev/null || true
case "$QDISC" in
  cake)     tc qdisc add dev "$IFACE" root cake bandwidth "$RATE" ;;
  fq_codel) tc qdisc add dev "$IFACE" root fq_codel ;;
  htb)      tc qdisc add dev "$IFACE" root handle 1: htb default 10
            tc class add dev "$IFACE" parent 1: classid 1:10 htb rate "$RATE" ceil "$RATE" ;;
esac
echo "tc: $QDISC on $IFACE at $RATE"
