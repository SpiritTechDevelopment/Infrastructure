#!/usr/sbin/nft -f
# Replace only this role's own table — never `flush ruleset` (that would wipe
# Docker's ip nat table and strand every published port). `destroy table` needs
# nft>=1.0.3; add+delete is the 1.0.2-compatible equivalent and leaves
# Docker-managed tables untouched, so no `docker restart` is required. The
# common role separately retires UFW and neutralises legacy INPUT hooks.
add table inet spiritvpn_filter
delete table inet spiritvpn_filter
table inet spiritvpn_filter {
  chain input {
    type filter hook input priority filter; policy drop;
    ct state invalid drop
    ct state established,related accept
    iifname "lo" accept
{% for interface in common_trusted_interfaces %}
    iifname "{{ interface }}" accept
{% endfor %}
    # ICMP is not one class, and the single 20/second bucket that used to stand
    # here treated it as one. Error signalling and IPv6 discovery keep the
    # network working; echo is a liveness oracle. They are separated on purpose.
    #
    # Errors belonging to a tracked flow are already accepted by the
    # `established,related` rule above — including the fragmentation-needed and
    # packet-too-big messages Path MTU Discovery depends on. These two rules
    # cover the same errors for flows conntrack does not know about.
    ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
    ip6 nexthdr ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

    # Neighbour and multicast discovery must never be rate-limited: they are how
    # IPv6 operates on the link, they arrive as NEW rather than related, and the
    # old shared bucket therefore throttled them. Starving them degrades
    # connectivity intermittently and under load, which looks like anything at
    # all except a firewall rule.
    ip6 nexthdr ipv6-icmp icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept

    # Echo only from the declared management networks. Trusted interfaces are
    # already accepted wholesale above, so this is what carries operator and
    # bootstrap diagnostics on hosts that reach the overlay without listing it
    # as trusted — which is every traffic node.
{% for cidr in common_icmp_echo_cidrs %}
{% if ':' in cidr %}
    ip6 saddr {{ cidr }} icmpv6 type echo-request limit rate 5/second accept
{% else %}
    ip saddr {{ cidr }} icmp type echo-request limit rate 5/second accept
{% endif %}
{% endfor %}

    # Everything else ICMP is dropped, including echo and timestamp from the
    # internet. Dropped rather than rejected: a rejection confirms the host just
    # as reliably as a reply would, and confirming the host is the whole thing
    # being prevented. Timestamp goes with it — it leaks the clock, which
    # correlates nodes across addresses.
    ip protocol icmp drop
    ip6 nexthdr ipv6-icmp drop

{% if ssh_allowed_cidrs | length > 0 %}
{% for cidr in ssh_allowed_cidrs %}
{% if ':' in cidr %}
    ip6 saddr {{ cidr }} tcp dport { {{ common_ssh_ports | join(', ') }} } accept
{% else %}
    ip saddr {{ cidr }} tcp dport { {{ common_ssh_ports | join(', ') }} } accept
{% endif %}
{% endfor %}
{% else %}
    tcp dport { {{ common_ssh_ports | join(', ') }} } accept
{% endif %}

{% if common_public_tcp_ports | length > 0 %}
    tcp dport { {{ common_public_tcp_ports | join(', ') }} } accept
{% endif %}
{% if common_public_udp_ports | length > 0 %}
    udp dport { {{ common_public_udp_ports | join(', ') }} } accept
{% endif %}

{% if common_restricted_tcp_rules | length > 0 %}
{% for rule in common_restricted_tcp_rules %}
{% if rule.ports | length > 0 and rule.cidrs | length > 0 %}
{% for cidr in rule.cidrs %}
{% set rule_interface = rule.interface | default(common_restricted_interface) %}
{% if ':' in cidr %}
    {% if rule_interface | length > 0 %}iifname "{{ rule_interface }}" {% endif %}ip6 saddr {{ cidr }} tcp dport { {{ rule.ports | join(', ') }} } accept
{% else %}
    {% if rule_interface | length > 0 %}iifname "{{ rule_interface }}" {% endif %}ip saddr {{ cidr }} tcp dport { {{ rule.ports | join(', ') }} } accept
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state invalid drop
    ct state established,related accept
{% for interface in common_trusted_interfaces %}
    iifname "{{ interface }}" accept
    oifname "{{ interface }}" accept
{% endfor %}
{% for interface in common_forward_interfaces %}
    # Только транзит, без доверия ко входу на сам хост. Управляющий хаб
    # пересылает оверлей сам в себя (оператор → хаб → нода), и это обязано
    # работать даже когда хост принимает из оверлея лишь несколько объявленных
    # портов. Раньше оба свойства давал один список, поэтому сузить вход было
    # нельзя, не сломав транзит.
    iifname "{{ interface }}" oifname "{{ interface }}" accept
{% endfor %}
{% if common_container_egress_interfaces | length > 0 %}
    # Container-initiated egress. Only `iifname`, deliberately: this lets a
    # container open an outbound connection and lets the reply back through the
    # `established,related` rule above, without accepting anything forwarded
    # *into* a container. Published ports keep arriving through the DNAT rules
    # below and nowhere else.
    #
    # Needed because almost everything here runs with `network_mode: host` and
    # so never reaches this chain at all. The control stack is the exception —
    # it uses a bridge network — and the first thing in it that had to dial out
    # found this policy the hard way: every connection timed out while the same
    # connection from the host succeeded.
{% for interface in common_container_egress_interfaces %}
    iifname "{{ interface }}" accept
{% endfor %}
{% endif %}
    # Docker-published ports are DNATed before filtering and therefore traverse
    # this forward chain (not the input chain) when userland-proxy is disabled.
{% if common_restricted_tcp_rules | length > 0 %}
{% for rule in common_restricted_tcp_rules %}
{% if rule.ports | length > 0 and rule.cidrs | length > 0 %}
{% set forward_ports = rule.forward_ports | default(rule.ports) %}
{% for cidr in rule.cidrs %}
{% set rule_interface = rule.interface | default(common_restricted_interface) %}
{% if ':' in cidr %}
    {% if rule_interface | length > 0 %}iifname "{{ rule_interface }}" {% endif %}ip6 saddr {{ cidr }} ct status dnat tcp dport { {{ forward_ports | join(', ') }} } accept
{% else %}
    {% if rule_interface | length > 0 %}iifname "{{ rule_interface }}" {% endif %}ip saddr {{ cidr }} ct status dnat tcp dport { {{ forward_ports | join(', ') }} } accept
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

  }

  chain output {
    type filter hook output priority filter; policy accept;
    # The second direction of the same rule. A host that never emits
    # echo-request to the internet cannot be provoked into revealing itself by a
    # probe that induces it to ping back, and cannot be used as a ping source.
    #
    # Only echo-request is dropped. Error signalling still leaves the host —
    # suppressing that would break Path MTU Discovery for anything connecting
    # *to* the public data port, which is the opposite of the intent.
{% for interface in common_trusted_interfaces %}
    oifname "{{ interface }}" ip protocol icmp icmp type echo-request accept
    oifname "{{ interface }}" ip6 nexthdr ipv6-icmp icmpv6 type echo-request accept
{% endfor %}
{% for cidr in common_icmp_echo_cidrs %}
{% if ':' in cidr %}
    ip6 daddr {{ cidr }} icmpv6 type echo-request accept
{% else %}
    ip daddr {{ cidr }} icmp type echo-request accept
{% endif %}
{% endfor %}
    ip protocol icmp icmp type echo-request drop
    ip6 nexthdr ipv6-icmp icmpv6 type echo-request drop
  }
}
