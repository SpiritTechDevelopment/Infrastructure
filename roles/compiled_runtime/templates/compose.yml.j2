name: {{ compose_project }}

# Предел на логи каждого контейнера.
#
# У драйвера json-file нет предела по умолчанию: файл растёт, пока на диске
# есть место, и первым это замечает не оператор, а перестающий писать
# postgres. Задаётся здесь, а не в /etc/docker/daemon.json, по одной причине:
# демон читает log-opts при создании контейнера и не перечитывает их на SIGHUP,
# так что daemon.json потребовал бы перезапуска Docker — а на хабе это простой
# Vault, базы и бэкенда. Здесь предел приезжает пересозданием контейнера,
# то есть обычной выкаткой.
x-logging: &logging
  driver: json-file
  options:
    max-size: "{{ compiled_runtime_log_max_size }}"
    max-file: "{{ compiled_runtime_log_max_files }}"

services:
  xray:
    image: {{ xray_image }}
    user: "0:0"
    restart: unless-stopped
    network_mode: host
    logging: *logging
    volumes:
      - {{ vpn_stack_dir }}/xray/config.json:/etc/xray/config.json:ro
      - /var/log/xray:/var/log/xray
    command: ["run", "-config", "/etc/xray/config.json"]
    healthcheck:
      test: ["CMD", "xray", "run", "-test", "-config", "/etc/xray/config.json"]
      interval: 15s
      timeout: 10s
      retries: 6
      start_period: 10s

  nginx-mask:
    image: {{ nginx_mask_image }}
    restart: unless-stopped
    network_mode: host
    logging: *logging
    volumes:
      - {{ vpn_stack_dir }}/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ vpn_stack_dir }}/nginx/site:/usr/share/nginx/html:ro
      - {{ vpn_stack_dir }}/nginx/certs:/etc/nginx/certs:ro
    healthcheck:
      test: ["CMD-SHELL", "wget -q --no-check-certificate -O- https://{{ mask_bind_address }}:{{ mask_port }}/ >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 6
      start_period: 10s

  node-exporter:
    image: {{ node_exporter_image }}
    restart: unless-stopped
    network_mode: host
    logging: *logging
    pid: host
    command: ["--path.rootfs=/host", "--web.listen-address={{ node_exporter_listen }}"]
    volumes:
      - /:/host:ro,rslave

  node-agent:
    image: {{ node_agent_image }}
    user: "{{ node_agent_uid }}:{{ node_agent_gid }}"
    restart: unless-stopped
    network_mode: host
    logging: *logging
    depends_on:
      xray:
        condition: service_healthy
    environment:
      SPIRIT_NODE_ID: "{{ spiritvpn_node_plan.logical_node.id }}"
      SPIRIT_GRPC_LISTEN: "{{ node_agent_grpc_listen }}"
      SPIRIT_HTTP_LISTEN: "{{ node_agent_http_listen }}"
      SPIRIT_GRPC_TLS_CERT_FILE: /run/spiritvpn-pki/server-chain.pem
      SPIRIT_GRPC_TLS_KEY_FILE: /run/spiritvpn-pki/server.key
      SPIRIT_GRPC_TLS_CLIENT_CA_FILE: /run/spiritvpn-pki/server-chain.pem
      SPIRIT_GRPC_ALLOWED_CLIENT_IDENTITIES: "{{ node_agent_allowed_client_identities | join(',') }}"
      SPIRIT_XRAY_API_ADDRESS: "{{ node_agent_xray_api_address }}"
      SPIRIT_XRAY_INBOUND_TAG: "{{ node_agent_xray_inbound_tag }}"
      SPIRIT_XRAY_LOCAL_OUTBOUND_TAG: "{{ node_agent_local_outbound_tag }}"
      SPIRIT_XRAY_FALLBACK_OUTBOUND_TAG: "{{ node_agent_fallback_outbound_tag }}"
      SPIRIT_STATE_DB_PATH: /var/lib/spirit-agent/state.db
      SPIRIT_MAX_INVENTORY_USERS: "{{ node_agent_max_inventory_users }}"
      SPIRIT_SHUTDOWN_TIMEOUT: "{{ node_agent_shutdown_timeout }}"
      SPIRIT_LOG_LEVEL: "{{ node_agent_log_level }}"
    volumes:
      - {{ node_agent_state_dir }}:/var/lib/spirit-agent
      - {{ node_agent_tls_dir }}:/run/spiritvpn-pki:ro
