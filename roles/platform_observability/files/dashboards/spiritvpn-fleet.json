{
  "uid": "spiritvpn-fleet",
  "title": "SpiritVPN — флот",
  "tags": ["spiritvpn"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Нагрузка CPU, %",
      "description": "Ноды и хаб. Хаб приходит из статической цели management/node-exporter, ноды — из file_sd своего окружения.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance_id) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance_id}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Занятая память, %",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{instance_id}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Сеть: приём, байт/с",
      "description": "Пропускная способность интерфейса, а не учтённый VPN-трафик: это разные величины.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "Bps", "min": 0, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[5m])",
          "legendFormat": "{{instance_id}} {{device}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Сеть: передача, байт/с",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "Bps", "min": 0, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[5m])",
          "legendFormat": "{{instance_id}} {{device}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Корневая файловая система, % занято",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "{{instance_id}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Агенты: живость",
      "description": "Единица — норма. needs_bootstrap выше нуля означает, что агент ждёт полной авторитетной сверки.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "spirit_agent_up", "legendFormat": "агент {{instance_id}}"},
        {"refId": "B", "expr": "spirit_agent_xray_up", "legendFormat": "xray {{instance_id}}"},
        {"refId": "C", "expr": "spirit_agent_needs_bootstrap", "legendFormat": "needs_bootstrap {{instance_id}}"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Агенты: неподтверждённые пачки usage",
      "description": "Растущая очередь означает, что учёт трафика не доезжает до бэкенда.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "spirit_agent_usage_outbox_batches", "legendFormat": "{{instance_id}}"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Бэкенд: вызовы агентов, 1/с",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "min": 0, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, code) (rate(spiritvpn_agent_calls_total[5m]))",
          "legendFormat": "{{method}} {{code}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Бэкенд: возраст последнего сбора usage, с",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "spiritvpn_node_usage_pull_age_seconds", "legendFormat": "{{node}}"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Доступность целей скрапа",
      "description": "Ноль — Prometheus не смог снять метрики. Хаб виден как job management/node-exporter.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "max": 1, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "up", "legendFormat": "{{job}} {{instance_id}}"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Бэкенд: Xray доступен агенту",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "max": 1, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "spiritvpn_node_xray_reachable", "legendFormat": "{{node}}"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "База: соединения",
      "description": "Верхняя граница — max_connections. Приближение к ней означает, что пул исчерпан и запросы начнут ждать.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 40},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (pg_stat_database_numbackends{datname!~\"template.*|postgres|\"})",
          "legendFormat": "{{datname}}"
        },
        {"refId": "B", "expr": "pg_settings_max_connections", "legendFormat": "предел"}
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "База: размер",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 40},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "bytes", "min": 0, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_database_size_bytes{datname!~\"template.*|postgres|\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "База: попадания в кэш, %",
      "description": "Проседание означает, что рабочий набор перестал помещаться в память и чтения пошли с диска.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 40},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(pg_stat_database_blks_hit{datname!~\"template.*|postgres|\"}[5m]) / clamp_min(rate(pg_stat_database_blks_hit{datname!~\"template.*|postgres|\"}[5m]) + rate(pg_stat_database_blks_read{datname!~\"template.*|postgres|\"}[5m]), 1)",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "База: транзакции и откаты, 1/с",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "ops", "min": 0, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres|\"}[5m]))",
          "legendFormat": "фиксации"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres|\"}[5m]))",
          "legendFormat": "откаты"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pg_stat_database_deadlocks{datname!~\"template.*|postgres|\"}[5m]))",
          "legendFormat": "взаимные блокировки"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "База: экспортер жив",
      "description": "Ноль означает, что экспортер не смог подключиться к базе — метрики выше в этот момент не значат ничего.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "max": 1, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "pg_up", "legendFormat": "pg_up"}
      ]
    },
    {
    "id": 17,
    "type": "stat",
    "title": "Трафик за период, GB",
    "description": "RX + TX публичного интерфейса за выбранный диапазон Grafana.",
    "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
    "datasource": {
      "type": "prometheus",
      "uid": "spiritvpn-prometheus"
    },
    "fieldConfig": {
      "defaults": {
        "unit": "none",
        "decimals": 2,
        "min": 0
      },
      "overrides": []
    },
    "options": {
      "reduceOptions": {
        "values": false,
        "calcs": ["lastNotNull"],
        "fields": ""
      },
      "orientation": "auto",
      "textMode": "auto",
      "colorMode": "value",
      "graphMode": "area",
      "justifyMode": "auto"
    },
    "targets": [
      {
        "refId": "A",
        "instant": true,
        "range": false,
        "expr": "sum by (environment, logical_node, instance_id) (increase(node_network_receive_bytes_total{job=~\".*/node-exporter\",node_role=~\"entry|exit\",device=~\"ens3|eth0\"}[$__range]) + increase(node_network_transmit_bytes_total{job=~\".*/node-exporter\",node_role=~\"entry|exit\",device=~\"ens3|eth0\"}[$__range])) / 1000000000",
        "legendFormat": "{{instance_id}}"
      }
    ]
  }
  ]
}
