{
  "uid": "spiritvpn-fleet",
  "title": "SpiritVPN — флот",
  "tags": ["spiritvpn"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Нагрузка CPU, %",
      "description": "Ноды и хаб. Хаб приходит из статической цели management/node-exporter, ноды — из file_sd своего окружения.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance_id) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance_id}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Занятая память, %",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{instance_id}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Сеть: приём, байт/с",
      "description": "Пропускная способность интерфейса, а не учтённый VPN-трафик: это разные величины.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "Bps", "min": 0, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[5m])",
          "legendFormat": "{{instance_id}} {{device}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Сеть: передача, байт/с",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "Bps", "min": 0, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[5m])",
          "legendFormat": "{{instance_id}} {{device}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Корневая файловая система, % занято",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "{{instance_id}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Агенты: живость",
      "description": "Единица — норма. needs_bootstrap выше нуля означает, что агент ждёт полной авторитетной сверки.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "spirit_agent_up", "legendFormat": "агент {{instance_id}}"},
        {"refId": "B", "expr": "spirit_agent_xray_up", "legendFormat": "xray {{instance_id}}"},
        {"refId": "C", "expr": "spirit_agent_needs_bootstrap", "legendFormat": "needs_bootstrap {{instance_id}}"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Агенты: неподтверждённые пачки usage",
      "description": "Растущая очередь означает, что учёт трафика не доезжает до бэкенда.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "spirit_agent_usage_outbox_batches", "legendFormat": "{{instance_id}}"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Бэкенд: вызовы агентов, 1/с",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "min": 0, "custom": {"fillOpacity": 8}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, code) (rate(spiritvpn_agent_calls_total[5m]))",
          "legendFormat": "{{method}} {{code}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Бэкенд: возраст последнего сбора usage, с",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "spiritvpn_node_usage_pull_age_seconds", "legendFormat": "{{node}}"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Доступность целей скрапа",
      "description": "Ноль — Prometheus не смог снять метрики. Хаб виден как job management/node-exporter.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "max": 1, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "up", "legendFormat": "{{job}} {{instance_id}}"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Бэкенд: Xray доступен агенту",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "datasource": {"type": "prometheus", "uid": "spiritvpn-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "max": 1, "custom": {"fillOpacity": 0}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "expr": "spiritvpn_node_xray_reachable", "legendFormat": "{{node}}"}
      ]
    }
  ]
}
