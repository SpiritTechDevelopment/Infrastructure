name: spiritvpn-observability

# Предел на логи каждого контейнера. См. тот же блок в roles/compiled_runtime:
# у json-file нет предела по умолчанию, а daemon.json потребовал бы перезапуска
# Docker — то есть простоя всего, что крутится на хабе.
x-logging: &logging
  driver: json-file
  options:
    max-size: "{{ platform_observability_log_max_size }}"
    max-file: "{{ platform_observability_log_max_files }}"

services:
  prometheus:
    image: {{ platform_prometheus_image }}
    user: "{{ platform_prometheus_uid }}:{{ platform_prometheus_gid }}"
    restart: unless-stopped
    logging: *logging
    stop_grace_period: 30s
    # Host networking so scrapes leave through the WireGuard hub directly and
    # arrive at the nodes with a management-network source address, which is
    # what their nftables rules allow.
    network_mode: host
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ platform_prometheus_retention_days }}d
      - --web.listen-address={{ platform_prometheus_bind_address }}:{{ platform_prometheus_port }}
      # The admin API can delete series and the lifecycle API can reload or
      # shut down the process over plain HTTP. Target changes arrive through
      # file_sd, which needs neither. Both are off by default; saying so
      # explicitly keeps the decision in the file rather than only in this
      # comment.
      #
      # The negated form is the only one that works: these are kingpin boolean
      # flags, declared as --[no-]web.enable-lifecycle, and they take no value.
      # Written as `=false` the flag parsed as a bare `false` positional and
      # Prometheus refused to start with "unexpected false", restarting in a
      # loop until the readiness gate failed the deployment.
      - --no-web.enable-lifecycle
    volumes:
      - {{ platform_observability_dir }}/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ platform_observability_targets_dir }}:{{ platform_prometheus_targets_container_dir }}:ro
      - {{ platform_prometheus_rules_dir }}:{{ platform_prometheus_rules_container_dir }}:ro
      - {{ platform_observability_state_dir }}:/prometheus

  alertmanager:
    image: {{ platform_alertmanager_image }}
    user: "{{ platform_alertmanager_uid }}:{{ platform_alertmanager_gid }}"
    restart: unless-stopped
    logging: *logging
    network_mode: host
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.listen-address={{ platform_alertmanager_bind_address }}:{{ platform_alertmanager_port }}
    volumes:
      - {{ platform_alertmanager_dir }}/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - {{ platform_alertmanager_state_dir }}:/alertmanager
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://{{ platform_alertmanager_bind_address }}:{{ platform_alertmanager_port }}/-/ready >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 6
      start_period: 10s

  node-exporter:
    image: {{ platform_node_exporter_image }}
    restart: unless-stopped
    logging: *logging
    # Host networking and the host PID namespace are what make the readings
    # describe the hub rather than the container: without them the exporter
    # reports one namespace's interfaces and processes.
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
      - --web.listen-address={{ platform_node_exporter_bind_address }}:{{ platform_node_exporter_port }}
    volumes:
      - /:/host:ro,rslave

  loki:
    image: {{ platform_loki_image }}
    user: "{{ platform_loki_uid }}:{{ platform_loki_gid }}"
    restart: unless-stopped
    logging: *logging
    # Host networking, как у всех здесь. Слушатель при этом единственный в этой
    # роли, который обязан быть достижим извне хоста: в него пишут ноды обеих
    # сред через оверлей. Держит его закрытым фаервол — цепочка input имеет
    # policy drop и принимает только lo и wg0.
    network_mode: host
    command: ["-config.file=/etc/loki/config.yml"]
    volumes:
      - {{ platform_loki_dir }}/config.yml:/etc/loki/config.yml:ro
      - {{ platform_loki_state_dir }}:/loki
    # Пробы здесь нет намеренно, и это свойство образа, а не недосмотр.
    # grafana/loki собран на gcr.io/distroless/static: внутри лежит один бинарь
    # loki и сертификаты — ни шелла, ни wget, ни curl. Любая проба вида
    # CMD-SHELL проваливается ещё до обращения к /ready, контейнер навсегда
    # остаётся starting, и `up --wait` падает по таймауту при полностью живом
    # Loki. Готовность проверяет задача роли «Require the log store to be
    # ready»: она обращается к тому же /ready с хоста, где есть чем.

  alloy:
    image: {{ platform_alloy_image }}
    # Root, и это следствие доступа к сокету Docker, а не небрежность: сокет
    # принадлежит root:docker, а членство в группе docker равносильно root на
    # хосте ровно так же. Прятать это за непривилегированным uid в группе
    # docker значило бы делать вид, что доступ меньше, чем он есть.
    #
    # Цена решения названа прямо: скомпрометированный Alloy на этом хосте — это
    # управление всеми контейнерами, включая Vault. Взамен в Grafana видны
    # имена сервисов, а не идентификаторы контейнеров.
    user: "0:0"
    restart: unless-stopped
    logging: *logging
    network_mode: host
    command:
      - run
      - --storage.path=/var/lib/alloy
      # Слушателя нет вовсе: UI Alloy показывает конвейер и содержимое
      # обрабатываемых строк, то есть ещё одну поверхность с теми же данными.
      - --server.http.listen-addr=127.0.0.1:12345
      - /etc/alloy/config.alloy
    # service_started, а не service_healthy: у Loki нет пробы, и ждать по ней
    # нечего. Порядок запуска сохраняется, а разрыв между «процесс поднялся» и
    # «ингестер принимает» закрывает сам шипер — loki.write повторяет неудачные
    # отправки с отступом, и первые секунды отказов ему ничего не стоят.
    depends_on:
      loki:
        condition: service_started
    volumes:
      - {{ platform_alloy_dir }}/config.alloy:/etc/alloy/config.alloy:ro
      - {{ platform_alloy_state_dir }}:/var/lib/alloy
      - /var/run/docker.sock:/var/run/docker.sock

  grafana:
    image: {{ platform_grafana_image }}
    user: "{{ platform_grafana_uid }}:{{ platform_grafana_gid }}"
    restart: unless-stopped
    logging: *logging
    network_mode: host
    environment:
      GF_SERVER_HTTP_ADDR: "{{ platform_grafana_bind_address }}"
      GF_SERVER_HTTP_PORT: "{{ platform_grafana_port }}"
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/grafana/admin-password
      GF_AUTH_ANONYMOUS_ENABLED: "{{ platform_grafana_anonymous_enabled | bool | lower }}"
      GF_AUTH_ANONYMOUS_ORG_ROLE: "{{ platform_grafana_anonymous_role }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      # The hub reaches the internet, so every phone-home is a real outbound
      # request from the machine that holds Vault. None of them are needed to
      # render a provisioned dashboard.
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
    volumes:
      - {{ platform_grafana_dir }}/provisioning:/etc/grafana/provisioning:ro
      - {{ platform_grafana_dir }}/dashboards:/etc/grafana/dashboards:ro
      - {{ platform_grafana_admin_password_file }}:/run/grafana/admin-password:ro
      - {{ platform_grafana_state_dir }}:/var/lib/grafana
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://{{ platform_grafana_bind_address }}:{{ platform_grafana_port }}/api/health >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 6
      start_period: 20s
