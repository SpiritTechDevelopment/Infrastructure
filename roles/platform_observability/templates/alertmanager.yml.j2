{{ ansible_managed | comment }}
# Rendered with the bot token inline and kept at 0400. The pinned release does
# accept bot_token_file, but the token arrives here as a variable: writing it
# out separately would only create a second copy of the same secret on the same
# host, under the same ownership.
global:
  resolve_timeout: 5m

route:
  receiver: telegram
  # Grouped by what broke and where, so one bad node is one message rather than
  # one message per rule.
  group_by: ['alertname', 'environment']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: {{ platform_alertmanager_repeat_interval }}

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: {{ platform_alertmanager_telegram_bot_token | to_json }}
        chat_id: {{ platform_alertmanager_telegram_chat_id | int }}
{% if platform_alertmanager_telegram_thread_id | string | length > 0 %}
        message_thread_id: {{ platform_alertmanager_telegram_thread_id | int }}
{% endif %}
        parse_mode: HTML
        send_resolved: true
        message: |-
{% raw %}
          {{ range .Alerts }}<b>{{ .Status | toUpper }}</b> {{ .Labels.alertname }}
          {{ .Annotations.summary }}
          {{ if .Labels.instance_id }}узел: {{ .Labels.instance_id }}{{ end }}
          {{ end }}
{% endraw %}
