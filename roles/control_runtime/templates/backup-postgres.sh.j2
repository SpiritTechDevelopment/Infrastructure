#!/usr/bin/env bash
set -euo pipefail

backup_dir='{{ control_plan.paths.backups }}'
compose_file='{{ control_plan.paths.root }}/compose.yml'
environment='{{ control_plan.environment }}'
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
temporary="$backup_dir/.${environment}-${timestamp}.dump.tmp"
target="$backup_dir/${environment}-${timestamp}.dump"
trap 'rm -f -- "$temporary"' EXIT

umask 077
docker compose -f "$compose_file" exec -T --user postgres postgres \
  pg_dump --format=custom --no-owner \
  --username '{{ control_plan.postgres.owner_user }}' \
  '{{ control_plan.postgres.database }}' > "$temporary"
test -s "$temporary"
mv -- "$temporary" "$target"
printf '%s\n' "$target"
