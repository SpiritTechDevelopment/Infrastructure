name: spiritvpn-control-{{ control_plan.environment }}

# Предел на логи каждого контейнера. См. тот же блок в roles/compiled_runtime:
# у json-file нет предела по умолчанию, а задать его в daemon.json значит
# перезапустить Docker — здесь это простой базы, бэкенда и Vault.
x-logging: &logging
  driver: json-file
  options:
    max-size: "{{ control_log_max_size }}"
    max-file: "{{ control_log_max_files }}"

services:
  postgres:
    image: {{ control_plan.postgres.image }}
    restart: unless-stopped
    logging: *logging
    stop_grace_period: 60s
    environment:
      POSTGRES_DB: "{{ control_plan.postgres.database }}"
      POSTGRES_USER: "{{ control_plan.postgres.owner_user }}"
      POSTGRES_PASSWORD_FILE: /run/spiritvpn-secrets/postgres-owner-password
    volumes:
      - {{ control_plan.paths.postgres_data }}:/var/lib/postgresql/data
      - {{ control_plan.paths.secrets }}/postgres-owner-password:/run/spiritvpn-secrets/postgres-owner-password:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ control_plan.postgres.owner_user }} -d {{ control_plan.postgres.database }}"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 10s
    networks: [control]

  postgres-exporter:
    image: {{ control_plan.postgres.exporter_image }}
    # The owner password file is root:{{ control_postgres_gid }} mode 0440, so the exporter
    # joins that group rather than the file being loosened for it.
    user: "{{ control_postgres_uid }}:{{ control_postgres_gid }}"
    restart: unless-stopped
    logging: *logging
    environment:
      DATA_SOURCE_URI: "postgres:5432/{{ control_plan.postgres.database }}?sslmode=disable"
      DATA_SOURCE_USER: "{{ control_plan.postgres.owner_user }}"
      DATA_SOURCE_PASS_FILE: /run/spiritvpn-secrets/postgres-owner-password
      PG_EXPORTER_WEB_LISTEN_ADDRESS: ":{{ control_plan.network.postgres_metrics_port }}"
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      # Same rule as the backend's metrics port: connection counts, table sizes
      # and query activity describe the fleet, so this binds the management
      # address and never a wildcard.
      - "{{ control_plan.network.management_address }}:{{ control_plan.network.postgres_metrics_port }}:{{ control_plan.network.postgres_metrics_port }}"
    volumes:
      - {{ control_plan.paths.secrets }}/postgres-owner-password:/run/spiritvpn-secrets/postgres-owner-password:ro
    networks: [control]

  migrate:
    image: {{ control_plan.backend.migration_image }}
    profiles: [migration]
    logging: *logging
    env_file: [{{ control_plan.paths.root }}/migration.env]
    networks: [control]

  backend:
    image: {{ control_plan.backend.image }}
    # Both halves, explicitly. The image declares a numeric USER without a
    # group, which makes the container's gid 0 — so the process never joins the
    # group the secret files are prepared for, and /secrets (0750 root:gid) is
    # not even traversable. Naming the gid here is what makes the ownership this
    # role sets on those files mean anything.
    user: "{{ control_backend_uid }}:{{ control_backend_gid }}"
    restart: unless-stopped
    logging: *logging
    stop_grace_period: 30s
    env_file: [{{ control_plan.paths.root }}/backend.env]
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "{{ control_plan.network.management_address }}:{{ control_plan.network.backend_host_port }}:{{ control_plan.network.backend_container_port }}"
      # The service port has neither TLS nor caller checks, and /metrics
      # discloses fleet composition, traffic volumes and queue depths. It is
      # bound to the management address so Prometheus can reach it and nothing
      # else can; it must never be published on a wildcard.
      - "{{ control_plan.network.management_address }}:{{ control_plan.network.backend_metrics_port }}:{{ control_plan.network.backend_metrics_port }}"
    volumes:
      - {{ control_plan.paths.secrets }}:/secrets:ro
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8080/health/ready"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 15s
    networks: [control]

networks:
  control:
    internal: false
